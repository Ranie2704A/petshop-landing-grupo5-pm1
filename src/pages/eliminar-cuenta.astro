---
import { getEntry } from 'astro:content';
import LegalLayout from '../layouts/LegalLayout.astro';

const entry = await getEntry('legal', 'eliminar-cuenta');
if (!entry) {
  throw new Error('No se encontró la entrada de colección legal: eliminar-cuenta');
}

const { Content } = await entry.render();

const mailtoSubject = encodeURIComponent("Solicitud de Eliminación de Cuenta - PetCare HN");
const mailtoBody = encodeURIComponent(`Estimado equipo de soporte de PetCare HN,

Solicito formalmente la eliminación definitiva de mi cuenta y la supresión de mis datos personales asociados, conforme a las políticas de Google Play Store.

Datos de la cuenta a eliminar:
- Correo electrónico registrado: [ESCRIBE TU CORREO REGISTRADO AQUÍ]
- Nombre completo del titular: [ESCRIBE TU NOMBRE COMPLETO AQUÍ]
- Motivo de la baja (opcional): 

Entiendo que una vez procesada, esta acción no podrá revertirse respecto a mis datos personales y perfiles registrados.

Atentamente,
[TU NOMBRE]`);

const quickMailtoLink = `mailto:soporte@petcarehn.com?subject=${mailtoSubject}&body=${mailtoBody}`;
---

<LegalLayout
  title={entry.data.title}
  description={entry.data.description}
  lastUpdated={entry.data.lastUpdated}
  effectiveDate={entry.data.effectiveDate}
  version={entry.data.version}
  badge={entry.data.badge}
>
  <div class="not-prose mb-10 p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-rose-50 via-white to-rose-50/50 border-2 border-rose-200/90 shadow-md">
    <div class="flex items-start gap-4">
      <div class="p-3 rounded-2xl bg-rose-600 text-white shrink-0 shadow-sm">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
        </svg>
      </div>
      <div class="flex-1">
        <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-100 text-rose-800 border border-rose-300 mb-2">
          Acción Directa sin Autenticación Obligatoria
        </span>
        <h3 class="text-xl font-black text-slate-900 tracking-tight">
          Botón Rápido de Solicitud de Eliminación por Correo Electrónico
        </h3>
        <p class="text-sm text-slate-600 mt-1 leading-relaxed">
          Haz clic en el siguiente botón para generar de forma inmediata un correo electrónico con el asunto y la información estructurada que requiere nuestro equipo para procesar la baja de tu cuenta:
        </p>

        <div class="mt-5 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
          <a
            href={quickMailtoLink}
            class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-2xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-sm shadow-md hover:shadow-lg hover:shadow-rose-600/30 transition-all hover:scale-[1.02] active:scale-[0.98]"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <span>Generar Correo de Solicitud (soporte@petcarehn.com)</span>
          </a>

          <span class="text-xs text-slate-500 text-center sm:text-left">
            ⚡ Tiempo de respuesta: máximo <strong>30 días hábiles</strong>
          </span>
        </div>
      </div>
    </div>
  </div>

  <Content />
</LegalLayout>
