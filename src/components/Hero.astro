---
---

<section class="relative pt-32 pb-20 sm:pt-40 sm:pb-28 overflow-hidden bg-gradient-to-b from-brand-50/60 via-white to-slate-50">
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[500px] bg-gradient-to-tr from-brand-200/40 to-teal-100/30 rounded-full blur-3xl -z-10 pointer-events-none"></div>
  <div class="absolute top-1/3 right-10 w-96 h-96 bg-amber-100/30 rounded-full blur-3xl -z-10 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <div class="lg:col-span-7 text-center lg:text-left">
        
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-50 border border-brand-200 shadow-xs mb-6 text-xs sm:text-sm font-semibold text-brand-900">
          <span class="flex h-2 w-2 rounded-full bg-brand-500 animate-pulse"></span>
          <span>Plataforma Veterinaria Oficial</span>
          <span class="text-brand-300">•</span>
          <span class="text-brand-700 font-normal">Cuidado y Salud Animal</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-[1.12] mb-6">
          La salud y el cuidado de tu mascota en <span class="bg-gradient-to-r from-brand-600 to-teal-700 bg-clip-text text-transparent">tiempo real</span>.
        </h1>

        <p class="text-lg sm:text-xl text-slate-600 leading-relaxed max-w-2xl mx-auto lg:mx-0 mb-8 font-normal">
          <strong>PetCare HN</strong> es el ecosistema móvil que conecta a propietarios de mascotas con clínicas veterinarias en Honduras. Gestiona citas médicas, consulta el carnet de vacunación digital y accede al historial clínico compartido con total seguridad.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 mb-6" id="descarga">
          <a
            href="#descarga"
            class="inline-block hover:scale-105 transition-transform duration-200 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2 rounded-2xl"
            aria-label="Próximamente en Google Play Store"
          >
            <img
              src="/images/google-play-badge.svg"
              alt="Disponible Próximamente en Google Play"
              width="215"
              height="63"
              class="h-[60px] w-auto shadow-lg shadow-black/10 rounded-2xl"
              loading="eager"
            />
          </a>

          <a
            href="/privacidad"
            class="inline-flex items-center gap-2 px-6 py-4 rounded-2xl bg-white hover:bg-slate-50 text-slate-700 border border-slate-300/80 font-semibold text-sm transition-all shadow-xs hover:shadow-md"
          >
            <svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
            <span>Ver Políticas de Privacidad</span>
          </a>
        </div>

      </div>

      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <div class="relative w-full max-w-[340px] sm:max-w-[380px]">
          
          <div class="relative rounded-[48px] p-3.5 bg-slate-900 shadow-2xl shadow-slate-900/40 ring-1 ring-slate-800 border-4 border-slate-800">
            
            <div class="absolute top-5 left-1/2 -translate-x-1/2 w-4 h-4 bg-black rounded-full z-30 ring-2 ring-slate-800 flex items-center justify-center">
              <div class="w-1.5 h-1.5 bg-blue-950 rounded-full"></div>
            </div>

            <div class="rounded-[38px] overflow-hidden bg-slate-50 text-slate-800 flex flex-col font-sans select-none border border-slate-200">
              
              <div class="bg-brand-900 text-white px-6 pt-3 pb-2 flex items-center justify-between text-[11px] font-medium tracking-wide">
                <span>9:41 AM</span>
                <div class="flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"/>
                  </svg>
                  <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M17.778 8.222c-4.296-4.296-11.26-4.296-15.556 0A1 1 0 01.808 6.808c5.076-5.077 13.308-5.077 18.384 0a1 1 0 01-1.414 1.414zM14.95 11.05a7 7 0 00-9.9 0 1 1 0 01-1.414-1.414 9 9 0 0112.728 0 1 1 0 01-1.414 1.414zM12.12 13.88a3 3 0 00-4.242 0 1 1 0 01-1.415-1.415 5 5 0 017.072 0 1 1 0 01-1.415 1.415zM9 16a1 1 0 011-1h.01a1 1 0 110 2H10a1 1 0 01-1-1z" clip-rule="evenodd"/>
                  </svg>
                  <span>100%</span>
                </div>
              </div>

              <div class="bg-gradient-to-r from-brand-900 to-teal-800 text-white px-5 pt-3 pb-5 shadow-sm">
                <div class="flex items-center justify-between">
                  <div>
                    <span class="text-[11px] font-medium text-brand-200">¡Hola, Andrea! 👋</span>
                    <h2 class="text-base font-bold text-white tracking-tight">PetCare HN</h2>
                  </div>
                  <div class="w-8 h-8 rounded-full bg-brand-700/80 border border-brand-500/50 flex items-center justify-center text-xs font-bold text-white">
                    AH
                  </div>
                </div>
              </div>

              <div class="p-4 space-y-3.5 bg-slate-100/90 text-left">
                
                <div class="bg-white p-3.5 rounded-2xl shadow-sm border border-slate-200/70">
                  <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-xl bg-amber-100 flex items-center justify-center text-2xl shrink-0 border border-amber-200">
                      🐕
                    </div>
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center justify-between">
                        <h3 class="text-sm font-bold text-slate-900 truncate">Max</h3>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">
                          Al día
                        </span>
                      </div>
                      <p class="text-[11px] text-slate-500">Golden Retriever • 3 años</p>
                      <p class="text-[10px] text-brand-600 font-semibold mt-0.5">Expediente #HN-84920</p>
                    </div>
                  </div>
                </div>

                <div class="bg-gradient-to-br from-brand-700 to-brand-900 text-white p-4 rounded-2xl shadow-md relative overflow-hidden">
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-[10px] uppercase font-bold tracking-wider text-brand-200 flex items-center gap-1">
                      <span class="w-1.5 h-1.5 rounded-full bg-brand-300 animate-ping"></span>
                      Próxima Cita Médica
                    </span>
                    <span class="text-[10px] font-medium bg-white/20 px-2 py-0.5 rounded-full">
                      Confirmada
                    </span>
                  </div>
                  <div class="text-sm font-bold mb-1">Control de Vacunas Anual</div>
                  <div class="text-xs text-brand-100 flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5 text-brand-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    <span>28 Noviembre, 10:00 AM</span>
                  </div>
                  <div class="text-[11px] text-brand-200 mt-2 pt-2 border-t border-white/10 flex items-center justify-between">
                    <span>Dr. Carlos Mendoza (Veterinaria San Roque)</span>
                  </div>
                </div>

                <div class="grid grid-cols-4 gap-2 text-center">
                  <div class="bg-white p-2 rounded-xl border border-slate-200 shadow-xs flex flex-col items-center">
                    <span class="text-base mb-1">📅</span>
                    <span class="text-[10px] font-semibold text-slate-700">Citas</span>
                  </div>
                  <div class="bg-white p-2 rounded-xl border border-slate-200 shadow-xs flex flex-col items-center">
                    <span class="text-base mb-1">💉</span>
                    <span class="text-[10px] font-semibold text-slate-700">Vacunas</span>
                  </div>
                  <div class="bg-white p-2 rounded-xl border border-slate-200 shadow-xs flex flex-col items-center">
                    <span class="text-base mb-1">📋</span>
                    <span class="text-[10px] font-semibold text-slate-700">Historial</span>
                  </div>
                  <div class="bg-white p-2 rounded-xl border border-slate-200 shadow-xs flex flex-col items-center">
                    <span class="text-base mb-1">💊</span>
                    <span class="text-[10px] font-semibold text-slate-700">Recetas</span>
                  </div>
                </div>

                <div class="bg-white p-3 rounded-xl border border-slate-200 shadow-xs">
                  <div class="flex items-center justify-between text-[11px] font-bold text-slate-800 mb-1">
                    <span>Último Diagnóstico Veterinario</span>
                    <span class="text-[10px] text-slate-400 font-normal">14 Nov</span>
                  </div>
                  <p class="text-[11px] text-slate-600 line-clamp-2">
                    "Paciente con peso ideal (28.4 kg). Plan de desparasitación interna completado con éxito."
                  </p>
                </div>

              </div>

              <div class="bg-white border-t border-slate-200 px-6 py-2.5 flex items-center justify-around text-slate-400">
                <div class="flex flex-col items-center text-brand-600">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/>
                  </svg>
                  <span class="text-[9px] font-bold mt-0.5">Inicio</span>
                </div>
                <div class="flex flex-col items-center">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                  <span class="text-[9px] font-medium mt-0.5">Citas</span>
                </div>
                <div class="flex flex-col items-center">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                  </svg>
                  <span class="text-[9px] font-medium mt-0.5">Mascotas</span>
                </div>
                <div class="flex flex-col items-center">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                  </svg>
                  <span class="text-[9px] font-medium mt-0.5">Perfil</span>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
