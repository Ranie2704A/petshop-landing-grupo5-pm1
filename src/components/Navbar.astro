---
interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-brand-500 rounded-xl p-1">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-brand-700 to-brand-500 flex items-center justify-center shadow-md shadow-brand-500/20 group-hover:scale-105 transition-transform">
          <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            <circle cx="12" cy="12" r="9" stroke-width="1.5" stroke-dasharray="2 2" />
          </svg>
        </div>
        <div class="flex flex-col">
          <div class="flex items-center gap-1.5">
            <span class="text-xl font-black tracking-tight text-slate-900 group-hover:text-brand-600 transition-colors">
              PetCare<span class="text-brand-600">HN</span>
            </span>
            <span class="px-1.5 py-0.5 rounded text-[10px] font-extrabold uppercase bg-brand-100 text-brand-800 tracking-wider">
              Honduras
            </span>
          </div>
          <span class="text-[11px] font-medium text-slate-500 -mt-0.5">
            Gestión Veterinaria Móvil
          </span>
        </div>
      </a>

      <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-700">
        <a href="/" class="hover:text-brand-600 transition-colors py-1">Inicio</a>
        <a href="/#caracteristicas" class="hover:text-brand-600 transition-colors py-1">Características</a>
        <a href="/#roles" class="hover:text-brand-600 transition-colors py-1">Para Clínicas y Dueños</a>
        <a href="/#seguridad" class="hover:text-brand-600 transition-colors py-1">Seguridad</a>

        <div class="relative group/menu py-2">
          <button type="button" class="flex items-center gap-1 text-slate-700 hover:text-brand-600 transition-colors font-medium focus:outline-none">
            <span>Cumplimiento Legal</span>
            <svg class="w-4 h-4 text-slate-400 group-hover/menu:text-brand-600 transition-transform group-hover/menu:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          
          <div class="absolute left-0 mt-2 w-64 rounded-2xl bg-white shadow-xl border border-slate-100 p-2 opacity-0 invisible group-hover/menu:opacity-100 group-hover/menu:visible transition-all duration-200 translate-y-2 group-hover/menu:translate-y-0 z-50">
            <a href="/privacidad" class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-50 transition-colors group/item">
              <div class="p-2 rounded-lg bg-teal-50 text-brand-600 group-hover/item:bg-brand-600 group-hover/item:text-white transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
              </div>
              <div>
                <span class="block text-sm font-semibold text-slate-900">Política de Privacidad</span>
                <span class="block text-xs text-slate-500">Google Play Compliance</span>
              </div>
            </a>

            <a href="/eliminar-cuenta" class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-rose-50/50 transition-colors group/item">
              <div class="p-2 rounded-lg bg-rose-50 text-rose-600 group-hover/item:bg-rose-600 group-hover/item:text-white transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                </svg>
              </div>
              <div>
                <span class="block text-sm font-semibold text-slate-900">Eliminación de Cuenta</span>
                <span class="block text-xs text-slate-500">Mecanismo web y app</span>
              </div>
            </a>

            <a href="/terminos" class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-50 transition-colors group/item">
              <div class="p-2 rounded-lg bg-slate-100 text-slate-700 group-hover/item:bg-slate-800 group-hover/item:text-white transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
              </div>
              <div>
                <span class="block text-sm font-semibold text-slate-900">Términos y Condiciones</span>
                <span class="block text-xs text-slate-500">Condiciones de servicio</span>
              </div>
            </a>
          </div>
        </div>
      </nav>

      <div class="hidden sm:flex items-center gap-3">
        <a
          href="/#descarga"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-brand-600 text-white text-sm font-semibold transition-all duration-200 shadow-sm hover:shadow-md hover:scale-[1.02] active:scale-[0.98]"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3.609 1.814L13.792 12 3.61 22.186a2.38 2.38 0 0 1-.22-.98V2.794c0-.36.08-.7.22-.98zm11.238 11.24l2.42 2.42-11.89 6.84 9.47-9.26zm2.42-2.42l-2.42-2.42 9.47-9.26-11.89 6.84 4.84 4.84zm1.05 1.05l3.24 1.87c.96.55.96 1.45 0 2l-3.24 1.87-2.05-2.87 2.05-2.87z"/>
          </svg>
          <span>Google Play</span>
        </a>
      </div>

      <details class="md:hidden relative group">
        <summary class="list-none p-2 rounded-xl text-slate-700 hover:bg-slate-100 cursor-pointer focus:outline-none focus:ring-2 focus:ring-brand-500">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"/>
          </svg>
        </summary>
        <div class="absolute right-0 mt-3 w-72 p-4 bg-white rounded-2xl shadow-2xl border border-slate-200 z-50 flex flex-col gap-2">
          <a href="/" class="px-3 py-2 rounded-lg text-sm font-medium text-slate-800 hover:bg-slate-50">Inicio</a>
          <a href="/#caracteristicas" class="px-3 py-2 rounded-lg text-sm font-medium text-slate-800 hover:bg-slate-50">Características</a>
          <a href="/#roles" class="px-3 py-2 rounded-lg text-sm font-medium text-slate-800 hover:bg-slate-50">Clínicas y Dueños</a>
          <a href="/#seguridad" class="px-3 py-2 rounded-lg text-sm font-medium text-slate-800 hover:bg-slate-50">Seguridad</a>
          <div class="border-t border-slate-100 my-1 pt-2">
            <span class="px-3 text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">Documentos Legales</span>
            <a href="/privacidad" class="px-3 py-2 rounded-lg text-sm font-semibold text-brand-700 hover:bg-brand-50 flex items-center justify-between">
              <span>Política de Privacidad</span>
              <span class="text-[10px] bg-brand-100 px-1.5 py-0.5 rounded text-brand-800">Google Play</span>
            </a>
            <a href="/eliminar-cuenta" class="px-3 py-2 rounded-lg text-sm font-semibold text-rose-700 hover:bg-rose-50 flex items-center justify-between">
              <span>Eliminar Cuenta y Datos</span>
              <span class="text-[10px] bg-rose-100 px-1.5 py-0.5 rounded text-rose-800">Requerido</span>
            </a>
            <a href="/terminos" class="px-3 py-2 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-50">
              Términos de Servicio
            </a>
          </div>
          <a href="/#descarga" class="mt-2 w-full text-center py-2.5 rounded-xl bg-brand-600 text-white font-semibold text-sm">
            Próximamente en Google Play
          </a>
        </div>
      </details>

    </div>
  </div>
</header>
